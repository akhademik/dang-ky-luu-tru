{
  "name": "dang-ky-luu-tru",
  "version": "1.0.0",
  "description": "Module tích hợp đồng bộ tự động OCR từ Google Sheets lên Hệ thống KBTT (API v1.4)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "format": "biome format --write src test",
    "lint:biome": "biome check src test",
    "lint": "pnpm run check:svelte",
    "knip": "pnpm dlx knip",
    "test": "node --import jiti/register test/test-pipeline.ts",
    "check": "pnpm run check:svelte && pnpm run knip && pnpm test"
  },
  "keywords": [
    "kbtt",
    "luu-tru",
    "tam-tru",
    "google-sheets",
    "ocr",
    "integration",
    "pnpm"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "jiti": "^2.7.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  }
}
